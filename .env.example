# API Configuration (Public for client-side static export)
NEXT_PUBLIC_API_URL=

# Google reCAPTCHA Site Key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Google Analytics Tracking ID
NEXT_PUBLIC_GA_TRACKING_ID=
# The /availability page reads free/busy from the ChecaTurno console with an
# API key scoped to "Disponibilidad anonima" (read). Server-only, never
# NEXT_PUBLIC. Left commented so dotenv-safe does not require them; without the
# key the page says the calendar is not connected.
# CHECATURNO_API_KEY=
# CHECATURNO_API_URL=https://api.checaturno.mx/v1
